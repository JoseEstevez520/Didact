# Radix UI's `latest` npm packages still declare `peerDependencies.react` pinned to
# `^18.0.0 || ^19.0.0-rc.1` (not plain `^19.0.0`) as of the versions checked in
# specs/education-components/research.md Question 2 and design.md §2. A plain `npm install` on
# stable React 19 would need `--legacy-peer-deps`/`--force` for that reason. pnpm's default
# behavior is already more lenient than npm's here, but these three settings make the intent
# explicit and reproducible for anyone who clones this repo, instead of relying on pnpm's
# defaults silently doing the right thing:
#
# - auto-install-peers: install peer dependencies automatically instead of failing the install.
# - strict-peer-dependencies=false: don't hard-fail on a peer range mismatch like Radix's
#   19.0.0-rc.1 pin against a stable 19.x React -- warn, don't block.
# - dedupe-peer-dependents: hoist/dedupe packages that share the same peer dependencies (React)
#   into a single copy, which is what actually avoids "two React copies" bugs in a monorepo like
#   this one (packages/core and apps/docs both depend on react).
#
# This applies proactively: no Radix package is installed yet (the Phase 3 Badge doesn't need a
# primitive, see packages/core's README), but layer 1 of design.md §2 will need it, and this file
# exists so that install doesn't need to change on the day it does.
auto-install-peers=true
strict-peer-dependencies=false
dedupe-peer-dependents=true

# esbuild's postinstall allow-listing (a transitive dependency of tsup/vite/vitest, downloads its
# platform binary) lives in pnpm-workspace.yaml's `onlyBuiltDependencies` -- pnpm 11 reads that
# setting from the workspace file, not from here.
